# ==============================================================================
# CipherRoom — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in the values below.
# Never commit your .env.local or secret keys to version control.

# ── Supabase Configuration ────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anonymous_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ── Security & Cryptographic Secrets ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_32_byte_hex_session_secret
CLEANUP_SECRET=your_cron_cleanup_bearer_token

# ── Cloudflare R2 Storage (Optional for Large File Storage) ────────────────────
# Leave empty if using default Supabase Storage bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# ── Application URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
